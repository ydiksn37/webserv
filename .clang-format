# .clang-format
BasedOnStyle: Google

# --- 基本設定 ---
# C++規格をC++98に指定
Standard: Cpp03 

# 1行の最大文字数
ColumnLimit: 100

# タブ文字（\t）は絶対に使わず、スペースに変換する
UseTab: Never


# --- インデントと構造 ---
# 全体の基本インデントは2スペース
IndentWidth: 2

# public: などを左端（0スペース）に置く (2 - 2 = 0)
AccessModifierOffset: -2

# switch文のcaseのインデントを下げる（C++の標準的な見やすさ）
IndentCaseLabels: true

# --- 中括弧 {} と改行の制御 ---
# 波括弧 {} の位置（関数やクラスの直後は改行せず同じ行に置く）
BreakBeforeBraces: Attach

# 短い関数でも必ず改行を入れる（中身を1行にまとめない）
AllowShortFunctionsOnASingleLine: None

# 短いif文やループを1行にまとめるのを禁止する
AllowShortBlocksOnASingleLine: Never
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false

# クラス内の短い記述（enumなど）も1行にまとめない
AllowShortEnumsOnASingleLine: false


# --- 整列（アライメント）設定：コードを視覚的に美しく保つ ---
# 行末のコメントを縦に綺麗に揃える
AlignTrailingComments: true

# 複数行にまたがる演算子（&& や || など）の位置を綺麗に揃える
AlignOperands: Align

# 長い代入式などを改行した際、バックスラッシュ（\）を右端に揃える
AlignEscapedNewlines: Right

# 連続するマクロ定義を揃える
AlignConsecutiveMacros: true


# --- 関数と引数の改行ルール ---
# 引数が1行に収まらない場合、可能な限り1行に詰め込むのではなく、1引数につき1行ずつ綺麗に改行する
BinPackArguments: false
BinPackParameters: false

# コンストラクタの初期化子リストは、カンマの前で改行する
BreakConstructorInitializers: BeforeComma

# 長い関数呼び出しで改行する場合、括弧 ( の次の行はインデントを下げる
AlignAfterOpenBracket: Align


# --- 空白（スペース）と空行の制御 ---
# ポインタや参照の位置は左詰め（型に付ける）例: int* a;
PointerAlignment: Left

# 制御文 (if, while, for) の後には必ずスペースを1つ入れる
SpaceBeforeParens: ControlStatements

# キャストの括弧の後にはスペースを入れない 例: (int)a;
SpaceAfterCStyleCast: false

# 代入演算子（=）の前後には必ずスペースを入れる
SpaceBeforeAssignmentOperators: true

# テンプレートの <> の中にはスペースを入れない 例: vector<int>
SpacesInAngles: false

# 余分な連続する空行は最大1行までに自動で削除する（縦に間延びするのを防ぐ）
MaxEmptyLinesToKeep: 1

# ブロック {} の開始直後にある無駄な空行を削除する
KeepEmptyLinesAtTheStartOfBlocks: false


# --- Include 制御 ---
# Includeの順番は人間が書いた通りを維持する
SortIncludes: Never
